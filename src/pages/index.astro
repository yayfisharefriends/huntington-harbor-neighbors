
---
import { getCollection } from "astro:content";

const allSpecies = await getCollection("species");
const species = allSpecies
  .filter((entry) => entry.data.status === "Published")
  .sort((a, b) =>
    a.data.commonName.localeCompare(b.data.commonName)
  );

const imagePath = (path: string) => {
  if (!path) return "";
  return path.startsWith("/") ? path : `/media/${path}`;
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Huntington Harbor Neighbors | Local Wildlife</title>
    <meta
      name="description"
      content="Explore the wildlife of Huntington Harbor and the surrounding coast."
    />
  </head>

  <body>
    <header>
      <a href="/" class="brand">Huntington Harbor Neighbors</a>
      <span class="header-note">A guide to our local wildlife</span>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">EXPLORE OUR COASTAL BACKYARD</p>
        <h1>Meet your wild<br />neighbors.</h1>
        <p class="hero-description">
          Discover the birds, mammals, reptiles, fish, and other remarkable
          wildlife that call Huntington Harbor and our surrounding coast home.
        </p>
        <a href="#species" class="explore-button">Explore the species ↓</a>
      </section>

      <section id="species" class="catalog">
        <div class="section-heading">
          <div>
            <p class="eyebrow">THE WILDLIFE DIRECTORY</p>
            <h2>Our wild neighbors</h2>
          </div>
          <span class="count">{species.length} species</span>
        </div>

        {species.length > 0 ? (
          <div class="species-grid">
            {species.map((entry) => (
              <a
                class="species-card"
                href={`/species/${entry.data.slug}`}
              >
                {entry.data.mainImage ? (
                  <img
                    src={imagePath(entry.data.mainImage)}
                    alt={entry.data.commonName}
                    class="card-image"
                  />
                ) : (
                  <div class="image-placeholder">Wildlife photograph</div>
                )}

                <div class="card-content">
                  <span class="animal-group">
                    {entry.data.animalGroup}
                  </span>
                  <h3>{entry.data.commonName}</h3>
                  <p class="scientific">
                    {entry.data.scientificName}
                  </p>
                  <span class="native-status">
                    {entry.data.nativeStatus}
                  </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>Our wildlife directory is growing.</h3>
            <p>
              Species profiles will appear here as they are published.
              Check back soon!
            </p>
          </div>
        )}
      </section>
    </main>

    <footer>
      <p>Huntington Harbor Neighbors</p>
      <span>Celebrating and learning about the wildlife around us.</span>
    </footer>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f7f8f4;
    color: #293b30;
    font-family: Arial, sans-serif;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 7%;
    background: white;
    border-bottom: 1px solid #e7ebe4;
  }

  .brand {
    color: #304c3c;
    font-weight: bold;
    text-decoration: none;
  }

  .header-note {
    color: #78847b;
    font-size: 13px;
  }

  .hero {
    padding: 95px 8%;
    background: #e9efe6;
    text-align: center;
  }

  .eyebrow {
    color: #6d876e;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h1 {
    margin: 18px 0;
    color: #294735;
    font-family: Georgia, serif;
    font-size: clamp(48px, 8vw, 82px);
    line-height: 1.05;
  }

  .hero-description {
    max-width: 580px;
    margin: 0 auto 28px;
    color: #58685c;
    font-size: 17px;
    line-height: 1.8;
  }

  .explore-button {
    display: inline-block;
    padding: 13px 22px;
    border-radius: 30px;
    background: #46664e;
    color: white;
    text-decoration: none;
    font-size: 14px;
  }

  .catalog {
    max-width: 1200px;
    margin: auto;
    padding: 75px 28px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 30px;
  }

  h2 {
    margin: 8px 0 0;
    color: #294735;
    font-family: Georgia, serif;
    font-size: 36px;
  }

  .count {
    color: #78847b;
    font-size: 13px;
  }

  .species-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .species-card {
    overflow: hidden;
    border: 1px solid #e7ebe4;
    border-radius: 14px;
    background: white;
    color: inherit;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
  }

  .species-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px #293b3015;
  }

  .card-image,
  .image-placeholder {
    display: block;
    width: 100%;
    height: 235px;
    object-fit: cover;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    background: #e9efe6;
    color: #718174;
    font-family: Georgia, serif;
  }

  .card-content {
    padding: 20px;
  }

  .animal-group {
    color: #718b72;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  h3 {
    margin: 9px 0 3px;
    color: #304c3c;
    font-family: Georgia, serif;
    font-size: 23px;
  }

  .scientific {
    margin: 0 0 15px;
    color: #849087;
    font-family: Georgia, serif;
    font-style: italic;
  }

  .native-status {
    display: inline-block;
    padding: 5px 11px;
    border-radius: 20px;
    background: #edf2eb;
    color: #526e54;
    font-size: 11px;
  }

  .empty-state {
    padding: 65px 20px;
    border: 1px dashed #cbd6c9;
    border-radius: 14px;
    text-align: center;
  }

  .empty-state h3 {
    font-size: 25px;
  }

  .empty-state p {
    color: #78847b;
  }

  footer {
    padding: 35px 20px;
    background: white;
    color: #526457;
    text-align: center;
  }

  footer p {
    font-family: Georgia, serif;
    font-weight: bold;
  }

  footer span {
    color: #849087;
    font-size: 13px;
  }

  @media (max-width: 800px) {
    .species-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hero {
      padding: 70px 22px;
    }

    .species-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
